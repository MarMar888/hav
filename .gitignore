# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# CAD: the Python env and everything agentcad generates. Source lives in
# cad/hull.py; rebuild with `agentcad run hull.py` (see README).
/.venv-cad/
/cad/build/

# OpenFOAM decomposed solver output (hundreds of MB); regenerate with the case run scripts
cad/cfd/*/processor*/
